# Senha do conector. Gere com: openssl rand -hex 24
MCP_ACCESS_KEY=

# Endereço público https deste servidor (a Meta baixa as mídias daqui)
PUBLIC_BASE_URL=https://instagram-mcp.seudominio.com.br

# Tokens de longa duração de cada conta (gerados no painel do app da Meta)
IG_TOKENS={"nerdexperience":"IGAA...","nerdverso":"IGAA..."}

# Pasta persistente para agendamentos e tokens renovados
DATA_DIR=/data

